PORT=5000
NODE_ENV=development

# Frontend URL for OAuth2 ANAF callback redirects.
# In development (Vite dev server on port 5173), set this to the Vite server URL.
# In production (when Express serves the built frontend), leave empty or set to the same host as the API.
# Example: FRONTEND_URL=https://192.168.100.136:5173
FRONTEND_URL=

# Factureaza.ro API Integration
# Get your API key from https://app.factureaza.ro/settings/api
# For sandbox/testing use https://sandbox.factureaza.ro/graphql
FACTUREAZA_API_KEY=your_api_key_here
FACTUREAZA_ENDPOINT=https://sandbox.factureaza.ro/graphql
