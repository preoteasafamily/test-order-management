PORT=5000
NODE_ENV=production
FACTUREAZA_API_KEY=your_api_key_here
FACTUREAZA_ENDPOINT=https://sandbox.factureaza.ro/graphql

# ─── Configurare IP extern / port-forwarding ────────────────────────────────
# Setați PUBLIC_URL la URL-ul extern accesibil de pe internet (cu protocol și port).
# Este folosit de modulul E-factura SPV-V2 pentru a construi redirect_uri-ul OAuth2.
# Exemplu: https://123.45.67.89:5000 sau https://mydomeniu.ro
# Dacă lăsați gol, redirect_uri trebuie configurat manual în setările SPV-V2.
# PUBLIC_URL=https://123.45.67.89:5000

# URL-ul aplicației frontend (pentru redirect după OAuth2 callback).
# Dacă Express servește și frontend-ul, lăsați gol (se va afișa pagina HTML de rezultat).
# Dacă frontend-ul e pe alt port (Vite dev): https://192.168.x.x:5173
# FRONTEND_URL=

# Activare trust proxy pentru IP real în spatele NAT/port-forwarding.
# Setați la 1 dacă serverul e în spatele unui router sau reverse proxy.
# TRUST_PROXY=1
