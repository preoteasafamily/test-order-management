PORT=5000
NODE_ENV=production
FACTUREAZA_API_KEY=your_api_key_here
FACTUREAZA_ENDPOINT=https://sandbox.factureaza.ro/graphql

# ─── Configurare IP extern / port-forwarding ────────────────────────────────
# Setați PUBLIC_URL la URL-ul extern accesibil de pe internet (cu protocol și port).
# Este folosit de modulul E-factura SPV-V2 pentru a construi redirect_uri-ul OAuth2.
# Exemplu: https://123.45.67.89:5000 sau https://mydomeniu.ro
# Dacă lăsați gol, redirect_uri trebuie configurat manual în setările SPV-V2.
# PUBLIC_URL=https://123.45.67.89:5000

# URL-ul aplicației frontend (pentru redirect după OAuth2 callback).
# Dacă Express servește și frontend-ul, lăsați gol (redirect relativ).
# Dacă frontend-ul e pe alt port (Vite dev): https://192.168.x.x:5173
# FRONTEND_URL=

# Activare trust proxy pentru IP real în spatele NAT/port-forwarding.
# Setați la 1 dacă serverul e în spatele unui router sau reverse proxy.
# TRUST_PROXY=1

# ─── Mutual TLS – Certificat digital calificat ANAF ──────────────────────────
# Serverul ANAF (logincert.anaf.ro) impune prezentarea certificatului digital
# calificat (Mutual TLS) la schimbul de token OAuth2 (POST /token).
# Fără aceste variabile configurate, ANAF va returna HTTP 500 la schimbul de token.
#
# Pași de configurare:
#   1. Exportați certificatul digital calificat (token USB/smart card) în format PEM:
#        openssl pkcs12 -in certificat.p12 -clcerts -nokeys -out cert.pem
#        openssl pkcs12 -in certificat.p12 -nocerts -nodes -out key.pem
#   2. Stocați fișierele într-un director securizat (ex: /etc/anaf-certs/ sau ./certs/)
#   3. Setați variabilele de mai jos cu căile ABSOLUTE spre fișiere:
#
# ANAF_CERT_PATH=/cale/absoluta/catre/certificat.pem
# ANAF_KEY_PATH=/cale/absoluta/catre/cheie_privata.pem
# ANAF_CERT_PASSPHRASE=parola_cheie_privata_daca_este_criptata
#
# NOTĂ: Fișierele trebuie să fie lizibile de procesul Node.js (verificați permisiunile).
# NOTĂ: Nu comiteți fișierele .pem în repository – adăugați-le în .gitignore!
