PORT=5000
NODE_ENV=development

# Factureaza.ro API Integration
# Get your API key from https://app.factureaza.ro/settings/api
# For sandbox/testing use https://sandbox.factureaza.ro/graphql
FACTUREAZA_API_KEY=your_api_key_here
FACTUREAZA_ENDPOINT=https://sandbox.factureaza.ro/graphql

# ANAF OAuth2 / e-Factura SPV Integration
# Inregistrați aplicația la: https://www.anaf.ro/anaf/internet/ANAF/servicii_online/inreg_api
# Configurarea se face din interfața grafică (modulul e-Factura SPV) și este stocată în baza de date.
# Variabilele de mai jos sunt opționale – pot fi setate aici sau prin interfața aplicației.
#
# ANAF_CLIENT_ID=      # Client ID primit de la portalul ANAF
# ANAF_CLIENT_SECRET=  # Client Secret primit de la portalul ANAF (păstrați-l secret!)
# ANAF_REDIRECT_URI=   # URL de callback înregistrat la ANAF (ex: https://example.com/oauth/callback)
# ANAF_CIF=            # CIF-ul firmei furnizor (fără RO prefix, sau cu, conform înregistrării)
# ANAF_ENVIRONMENT=test # "test" (sandbox) sau "prod" (producție)
